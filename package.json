{
  "name": "chirpy-api",
  "version": "0.0.1",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "npx tsc && node dist/index.js",
    "dev:watch": "nodemon",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [],
  "author": "",
  "description": "Chirpy — a Twitter-like REST API built with Express, PostgreSQL and Drizzle ORM",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9"
  },
  "private": true
}
